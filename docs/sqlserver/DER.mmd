    materias ||..o{ assuntos : oferece
    turmas o|..o{ alunos : vincula
    turmas ||--o{ professor_turmas : inclui
    professores ||--o{ professor_turmas : leciona
    alunos ||..o| desempenho_adaptativo : possui
    alunos ||..o{ desempenho_por_assunto : possui
    assuntos ||..o{ desempenho_por_assunto : mede
    turmas ||..o| pontuacao_coletiva : acumula
    atividades ||..o{ questoes : contem
    assuntos o|..o{ questoes : classifica
    professores o|..o{ questoes : escreve
    alunos ||..o{ sessoes_estudo : inicia
    assuntos ||..o{ sessoes_estudo : contextualiza
    sessoes_estudo ||--o{ sessao_questoes : apresenta
    questoes ||..o{ sessao_questoes : integra
    sessao_questoes o|..o{ sessoes_estudo : permite_retomada
    alunos ||..o{ respostas_aluno : envia
    questoes ||..o{ respostas_aluno : recebe
    sessoes_estudo o|..o{ respostas_aluno : registra
    sessao_questoes o|..o{ respostas_aluno : autoriza
    alunos ||..o{ repeticao_espacada : agenda
    atividades o|..o{ repeticao_espacada : agenda_legada
    questoes o|..o{ repeticao_espacada : agenda
    turmas ||..o{ atividades_coletivas : participa
    professores o|..o{ atividades_coletivas : registra
    alunos ||..o{ recados : recebe
    professores ||..o{ recados : envia

FROM maven:3.9.11-eclipse-temurin-21 AS compilacao
WORKDIR /app
COPY pom.xml ./
COPY src ./src
RUN mvn -B -ntp package

FROM eclipse-temurin:21-jre-noble
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=compilacao /app/target/educria-backend-1.0.0-SNAPSHOT.jar ./educria.jar
USER 10001:10001
ENTRYPOINT ["java", "-jar", "/app/educria.jar"]

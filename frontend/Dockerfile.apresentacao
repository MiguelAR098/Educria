FROM node:22-bookworm-slim AS compilacao
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build \
    && npm prune --omit=dev --offline --no-audit --no-fund \
    && rm -rf .next/cache

FROM node:22-bookworm-slim
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY --chown=node:node --from=compilacao /app/package.json /app/next.config.mjs ./
COPY --chown=node:node --from=compilacao /app/node_modules ./node_modules
COPY --chown=node:node --from=compilacao /app/.next ./.next
USER node
CMD ["node", "node_modules/next/dist/bin/next", "start", "-H", "0.0.0.0", "-p", "3000"]
